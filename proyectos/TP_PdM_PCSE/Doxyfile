# Doxyfile - Estación de medición ambiental (TP final PdM)
#
# Genera la documentación en docs/doxygen/html/index.html.
# Solo se listan las opciones que cambian; el resto queda con su valor por defecto.

#---------------------------------------------------------------- Proyecto
PROJECT_NAME           = "Estación de medición ambiental"
PROJECT_BRIEF          = "TP final PdM - NUCLEO-F446RE con BME280, LCD I2C, encoder, alarma y consola"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = Spanish

#---------------------------------------------------------------- Fuentes
# Solo el código propio: ni la HAL, ni CMSIS, ni lo que genera CubeMX.
INPUT                  = README.md \
                         App \
                         Drivers/API \
                         Drivers/Port
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
INPUT_ENCODING         = UTF-8
IMAGE_PATH             = docs/diagramas

#---------------------------------------------------------------- Qué documentar
EXTRACT_ALL            = YES        # también lo que no tiene comentario
EXTRACT_STATIC         = YES        # funciones y variables privadas de cada módulo
EXTRACT_PRIVATE        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO         # respeta el orden de los archivos
SOURCE_BROWSER         = YES        # código fuente navegable
INLINE_SOURCES         = NO
WARN_IF_UNDOCUMENTED   = NO
QUIET                  = YES

#---------------------------------------------------------------- Salidas
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES        # árbol de navegación a la izquierda
HTML_COLORSTYLE        = LIGHT

#---------------------------------------------------------------- Diagramas (requiere graphviz)
HAVE_DOT               = YES
CALL_GRAPH             = YES        # a quién llama cada función
CALLER_GRAPH           = YES        # quién llama a cada función
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

#---------------------------------------------------------------- Preprocesador
# Para que Doxygen vea el código como se compila para la placa.
ENABLE_PREPROCESSING   = YES
PREDEFINED             = STM32F446xx USE_HAL_DRIVER \
                         HAL_I2C_MODULE_ENABLED HAL_TIM_MODULE_ENABLED \
                         APP_TEST=0 \
                         __attribute__(x)=
